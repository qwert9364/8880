local function threatens(p)
 if not p.Character or not LP.Character then return false end
 local eH=p.Character:FindFirstChild("HumanoidRootPart")local mH=LP.Character:FindFirstChild("HumanoidRootPart")
 if not eH or not mH then return false end
 local t=mH.Position-eH.Position
 if t.Magnitude<0.1 then return true end
 return eH.CFrame.LookVector:Dot(t.Unit)>0.5
end
local function inFOV(pos)
 local cm=cam()if not cm then return false end
 local vp=cm:WorldToViewportPoint(pos)
 if vp.Z<=0 then return false end
 return (Vector2.new(vp.X,vp.Y)-cm.ViewportSize/2).Magnitude<=CFG.Aim.fovsize
end
local function bestT()
 local b,bp=nil,-math.huge local cm=cam()if not cm then return nil end
 for _,p in ipairs(Players:GetPlayers())do
  if p~=LP and isAlive(p) and not(CFG.Aimbot.IgnoreTeammate and isMate(p))then
   if(not CFG.Aimbot.OnlyArmed or hasWeap(p))and(not CFG.Aimbot.OnlyThreat or threatens(p))then
    local pt=getTP(p.Character)
    if pt then
     local dist=(pt.Position-cm.CFrame.Position).Magnitude
     if dist<=CFG.Aim.distance then
      local sp,vis=cm:WorldToViewportPoint(pt.Position)
      local cr=vis and sp and(Vector2.new(sp.X,sp.Y)-cm.ViewportSize/2).Magnitude or math.huge
      local pri=0
      if CFG.Aim.priorityMode=="Distance"then pri=-dist
      elseif CFG.Aim.priorityMode=="Crosshair"then pri=-cr
      elseif CFG.Aim.priorityMode=="Speed"then pri=pt.AssemblyLinearVelocity.Magnitude
      else pri=-dist*0.5+pt.AssemblyLinearVelocity.Magnitude*0.3-cr*0.2 end
      if bp<pri and(not CFG.Aim.wallCheck or los(pt))then bp=pri b=p end
     end
    end
   end
  end
 end
 return b
end
local function rageT()
