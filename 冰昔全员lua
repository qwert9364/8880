local function doAim()
 if CFG.Rage.Enabled or not CFG.Aimbot.Enabled then return end
 if CFG.Aim.aimActivationMode=="按住"and not UIS:IsKeyDown(CFG.Aim.aimHotkey)then return end
 if CFG.Aim.aimActivationMode=="热键"and not CFG.Aim.hotkeyToggleState then return end
 local t=bestT()if not t or not t.Character then return end
 local pt=getTP(t.Character)if not pt then return end
 local pos=pt.Position
 if not inFOV(pos)then return end
 local cm=cam()if not cm then return end
 if CFG.Aim.prejudgingselfsighting then
  local d=(pos-cm.CFrame.Position).Magnitude
  if d<=CFG.Aim.prejudgingselfsightingdistance then
   local t2=d/1000
   pos=pos+pt.AssemblyLinearVelocity*t2+0.5*Vector3.new(0,-WS.Gravity,0)*t2^2
  end
 end
 local g=CFrame.new(cm.CFrame.Position,pos)
 if CFG.Aim.aimModeType=="强锁"then cm.CFrame=g
 else local a=math.clamp((CFG.Aim.aimSpeed/10)*(1/CFG.Aim.smoothness),0.02,0.8)cm.CFrame=cm.CFrame:Lerp(g,a)end
 pcall(function()cm.Focus=CFrame.new(cm.CFrame.Position+cm.CFrame.LookVector*100)end)
end
