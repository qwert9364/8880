local BTHook={Hooked=false,Status=""}
local function initBH()
 if BTHook.Hooked then return true end
 if not hookmetamethod or not getnamecallmethod then BTHook.Status="不支持" return false end
 local okk=pcall(function()
  local mt=getrawmetatable(game)
  local old=mt.__namecall
  setreadonly(mt,false)
  mt.__namecall=newcclosure(function(self,...)
   local m=getnamecallmethod()
   if BTHook.Enabled and m=="FireServer" and typeof(self)=="Instance" and self:IsA("RemoteEvent")then
    local st=true
    if CFG.BulletTrack.OnlyOnRage and not CFG.Rage.Enabled then st=false end
    if st then
     local args={...}
     local t=CFG.Rage.Target
     if not t or not t.Character then t=bestT()end
     if t and t.Character and not(CFG.BulletTrack.IgnoreTeammate and isMate(t))then
      local pt=getTP(t.Character)local cm=cam()
      if pt and cm then
       local d=(pt.Position-cm.CFrame.Position).Unit
       for i=1,#args do local a=args[i]
        if typeof(a)=="Vector3"then
         local mg=a.Magnitude
         if mg>0.5 and mg<1.5 then args[i]=d end
        elseif typeof(a)=="CFrame"then args[i]=CFrame.new(a.Position,pt.Position)end
       end
      end
     end
     return old(self,unpack(args))
    end
   end
   return old(self,...)
  end)
  setreadonly(mt,true)
 end)
 if okk then BTHook.Hooked=true return true end
 BTHook.Status="挂载失败" return false
end
local Ghost={Conn=nil,Backup={}}
local function applyGhost(char,on)
 if not char then return end
 local mode=CFG.Ghost.Mode
 for _,obj in ipairs(char:GetDescendants())do
  if obj:IsA("BasePart")then
   if on then
    if not Ghost.Backup[obj]then Ghost.Backup[obj]={T=obj.Transparency,M=obj.Material}end
    if mode=="本地透明"then obj.LocalTransparencyModifier=1
    elseif mode=="真隐身"then obj.Transparency=1 obj.LocalTransparencyModifier=1
    elseif mode=="幽灵"then
     obj.LocalTransparencyModifier=0.55
     pcall(function()obj.Transparency=0.55 end)
     pcall(function()obj.Material=Enum.Material.ForceField end)
    end
   else
    local b=Ghost.Backup[obj]
    if b then
     pcall(function()obj.Transparency=b.T end)
     pcall(function()obj.Material=b.M end)
     Ghost.Backup[obj]=nil
    end
    obj.LocalTransparencyModifier=0
   end
  elseif obj:IsA("Decal")then
   if on then
    if not Ghost.Backup[obj]then Ghost.Backup[obj]=obj.Transparency end
    obj.Transparency=(mode=="幽灵")and 0.55 or 1
   else
    if Ghost.Backup[obj]then obj.Transparency=Ghost.Backup[obj]Ghost.Backup[obj]=nil end
   end
  end
 end
end
